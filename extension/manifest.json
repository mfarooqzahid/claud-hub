{
  "manifest_version": 3,
  "name": "Claude Hub",
  "version": "0.8.4",
  "key": "",
  "description": "Switch between Claude accounts in one profile and carry the conversation over. Fully local, no server.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["cookies", "tabs", "storage", "scripting", "nativeMessaging", "clipboardWrite"],
  "host_permissions": ["https://claude.ai/*", "https://*.claude.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Hub",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
